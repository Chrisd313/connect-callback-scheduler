{
  "name": "connect-callback-scheduler",
  "version": "0.3.0",
  "private": true,
  "description": "Schedules outbound callbacks for Amazon Connect customers who opt for a callback instead of waiting in queue.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-connect": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-scheduler": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/node": "^20.14.0",
    "aws-sdk-client-mock": "^4.0.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
